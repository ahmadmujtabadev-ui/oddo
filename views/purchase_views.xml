<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="erp_purchase_order_view_list" model="ir.ui.view">
        <field name="name">erp.purchase.order.list</field>
        <field name="model">erp.purchase.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="erp_purchase_order_view_form" model="ir.ui.view">
        <field name="name">erp.purchase.order.form</field>
        <field name="model">erp.purchase.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_receive" string="Receive" type="object" class="btn-primary"
                            invisible="state != 'draft'" groups="my_module.group_erp_warehouse"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="quantity"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="erp_purchase_order_action" model="ir.actions.act_window">
        <field name="name">Purchase Orders</field>
        <field name="res_model">erp.purchase.order</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
