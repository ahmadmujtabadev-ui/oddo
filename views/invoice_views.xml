<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="erp_invoice_view_list" model="ir.ui.view">
        <field name="name">erp.invoice.list</field>
        <field name="model">erp.invoice</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="sale_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_total" sum="Total"/>
                <field name="amount_due" sum="Due"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="erp_invoice_view_form" model="ir.ui.view">
        <field name="name">erp.invoice.form</field>
        <field name="model">erp.invoice</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="sale_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="amount_total" readonly="1"/>
                            <field name="amount_paid"/>
                            <field name="amount_due"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payments" name="payments" groups="my_module.group_erp_accountant">
                            <field name="payment_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="erp_invoice_action" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">erp.invoice</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
